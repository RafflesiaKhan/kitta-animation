# Copy to .env (gitignored). Only the server reads these; the key never reaches the browser.
# Optional. Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini TTS model (docs: https://ai.google.dev/gemini-api/docs/speech-generation).
# Output: 24 kHz, 16-bit mono PCM/WAV. Voices: Kore, Puck, Charon, Zephyr, Fenrir, Leda, Aoede, Orus (+22 more).
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Current Flash text model (used by Auto-tag and Add expressions): https://ai.google.dev/gemini-api/docs/models
GEMINI_TEXT_MODEL=gemini-3.8-flash
# Image model used to create AI characters and draw their expressions/actions (Character step, "Create with AI").
# Must support image output and image editing. Check the current name: https://ai.google.dev/gemini-api/docs/image-generation
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Optional: OpenAI as an image provider for AI characters (use it instead of, or alongside, Gemini).
# With both keys set, the Create form lets you choose; a character keeps using the provider that painted it.
OPENAI_API_KEY=
# Image model with generations + edits support: https://platform.openai.com/docs/models
OPENAI_IMAGE_MODEL=gpt-image-2
# Vision model that finds the mouth when there is no Gemini key (with a Gemini key, Gemini does it).
OPENAI_VISION_MODEL=gpt-5-mini
# Matches script directions ([expression: …], [action: …]) when Gemini isn't set up or is busy
OPENAI_TEXT_MODEL=gpt-5-mini
# OpenAI voices (Voiceover step, "Voice by" OpenAI): uses OPENAI_API_KEY above.
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional: VoiceStudio, a free local voice app (github.com/debpalash/VoiceStudio): voice cloning, 600+ languages.
# Run it, then set its address to offer "Voice by: VoiceStudio (local)". It needs no key on this machine.
# VOICESTUDIO_URL=http://localhost:3900
# VOICESTUDIO_APP=/Applications/VoiceStudio.app   # opened automatically when VoiceStudio isn't running (macOS)
# VOICESTUDIO_API_KEY=        # only for a remote VoiceStudio backend
# VOICESTUDIO_TTS_MODEL=tts-1
