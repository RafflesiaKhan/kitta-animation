# Copy to .env (gitignored). Only the server reads these; the key never reaches the browser.
GEMINI_API_KEY=your-key-here
# Gemini TTS model (docs: https://ai.google.dev/gemini-api/docs/speech-generation).
# Output: 24 kHz, 16-bit mono PCM/WAV. Voices: Kore, Puck, Charon, Zephyr, Fenrir, Leda, Aoede, Orus (+22 more).
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Current Flash text model (used by Auto-tag in a later task): https://ai.google.dev/gemini-api/docs/models
GEMINI_TEXT_MODEL=gemini-3.8-flash
